# Stable anonymous app-user cookie signing. Required in production.
KAREN_SESSION_SECRET=

# Explicitly enable the sanitized offline demo in production.
KAREN_ENABLE_OFFLINE_DEMO=false

# Composio server-only configuration.
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_WEBHOOK_SECRET=

# Octen server-only configuration.
OCTEN_API_KEY=

# Optional OpenAI-compatible structured-output provider.
# Without these values, karen uses a conservative deterministic assembler.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional, application-controlled claims address. Production validation
# restricts this MVP value to an official flyasiana.com domain.
KAREN_CLAIMS_EMAIL=

# Optional airline registry extension:
# {"airline_key":{"name":"Airline Name","domains":["airline.example"]}}
KAREN_AIRLINE_DIRECTORY=
